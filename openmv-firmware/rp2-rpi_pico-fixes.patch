diff --git a/ports/rp2/omv_i2c.c b/ports/rp2/omv_i2c.c
index a0759e4..17020f4 100644
--- a/ports/rp2/omv_i2c.c
+++ b/ports/rp2/omv_i2c.c
@@ -141,6 +141,100 @@ int omv_i2c_write(omv_i2c_t *i2c, uint8_t slv_addr, uint8_t *buf, uint32_t len,
     return (bytes == len) ? 0 : -1;
 }
 
+int omv_i2c_read_sccb(omv_i2c_t *i2c, uint8_t slv_addr, uint8_t reg_addr, uint8_t *data) {
+    slv_addr = slv_addr >> 1;
+
+    // SCCB protocol requires a STOP between the write and read phases.
+    if (i2c_write_timeout_us(i2c->inst, slv_addr, &reg_addr, 1, false, I2C_TIMEOUT) != 1) {
+        return -1;
+    }
+
+    if (i2c_read_timeout_us(i2c->inst, slv_addr, data, 1, false, I2C_TIMEOUT) != 1) {
+        return -1;
+    }
+
+    return 0;
+}
+
+int omv_i2c_write_sccb(omv_i2c_t *i2c, uint8_t slv_addr, uint8_t reg_addr, uint8_t data) {
+    slv_addr = slv_addr >> 1;
+    uint8_t buf[] = {reg_addr, data};
+
+    if (i2c_write_timeout_us(i2c->inst, slv_addr, buf, 2, false, I2C_TIMEOUT) != 2) {
+        return -1;
+    }
+
+    return 0;
+}
+
+int omv_i2c_read_reg(omv_i2c_t *i2c, uint8_t slv_addr,
+                     uint32_t reg_addr, uint8_t addr_size,
+                     void *data, uint8_t data_size) {
+    slv_addr = slv_addr >> 1;
+
+    uint8_t addr_buf[2];
+    if (addr_size == 1) {
+        addr_buf[0] = reg_addr & 0xFF;
+    } else {
+        addr_buf[0] = (reg_addr >> 8) & 0xFF;
+        addr_buf[1] = reg_addr & 0xFF;
+    }
+
+    if (i2c_write_timeout_us(i2c->inst, slv_addr, addr_buf, addr_size, true, I2C_TIMEOUT) != addr_size) {
+        return -1;
+    }
+
+    uint8_t data_buf[4] = {0};
+    if (i2c_read_timeout_us(i2c->inst, slv_addr, data_buf, data_size, false, I2C_TIMEOUT) != data_size) {
+        return -1;
+    }
+
+    // Convert from big-endian to host byte order
+    uint32_t value = 0;
+    for (int i = 0; i < data_size; i++) {
+        value = (value << 8) | data_buf[i];
+    }
+
+    switch (data_size) {
+        case 1:
+            *(uint8_t *) data = value;
+            break;
+        case 2:
+            *(uint16_t *) data = value;
+            break;
+        case 4:
+            *(uint32_t *) data = value;
+            break;
+    }
+
+    return 0;
+}
+
+int omv_i2c_write_reg(omv_i2c_t *i2c, uint8_t slv_addr,
+                      uint32_t reg_addr, uint8_t addr_size,
+                      uint32_t data, uint8_t data_size) {
+    slv_addr = slv_addr >> 1;
+
+    uint8_t buf[2 + 4];
+    int idx = 0;
+    if (addr_size == 1) {
+        buf[idx++] = reg_addr & 0xFF;
+    } else {
+        buf[idx++] = (reg_addr >> 8) & 0xFF;
+        buf[idx++] = reg_addr & 0xFF;
+    }
+
+    for (int i = 0; i < data_size; i++) {
+        buf[idx++] = (data >> (8 * (data_size - 1 - i))) & 0xFF;
+    }
+
+    if (i2c_write_timeout_us(i2c->inst, slv_addr, buf, idx, false, I2C_TIMEOUT) != idx) {
+        return -1;
+    }
+
+    return 0;
+}
+
 int omv_i2c_pulse_scl(omv_i2c_t *i2c) {
     omv_i2c_deinit(i2c);
 
