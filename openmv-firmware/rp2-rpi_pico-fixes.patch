+// Cortex-M0/M0+ has no DWT cycle counter; approximate using the
+// microsecond-resolution hardware timer instead.
+#include "pico/time.h"
+static inline uint32_t omv_cycles_now(void) {
+    return time_us_32() * OMV_CYCLES_PER_US;
